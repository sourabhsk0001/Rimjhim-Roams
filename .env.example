# ==============================================================================
# Rimjhim Roams (TripWise AI) — Environment Variables
# ==============================================================================

# Supabase (Free Tier PostgreSQL + Auth + PostGIS + pgvector)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API (Free tier from Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key-here

# Groq LPU API (Ultra-fast LLM Inference from Groq Console)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gemini Daily Quotas (Student Project Free-Tier Fair Usage)
GEMINI_DAILY_USER_LIMIT=20
GEMINI_DAILY_SERVER_LIMIT=1000
